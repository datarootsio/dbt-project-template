# Required
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Auth (recommended: externalbrowser or oauth or jwt)
# externalbrowser | oauth | snowflake_jwt
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Password (optional / legacy)
SNOWFLAKE_PASSWORD=

# OAuth (optional)
SNOWFLAKE_OAUTH_CLIENT_ID=
SNOWFLAKE_OAUTH_CLIENT_SECRET=
SNOWFLAKE_OAUTH_ACCESS_TOKEN=

# JWT / key-pair (optional)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Optional
SNOWFLAKE_KEEP_ALIVE=false

# General
DBT_THREADS=4
DBT_TARGET=dev
