dbt_project_template:
  target: "{{ env_var('DBT_TARGET', 'dev') }}"
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', '') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA') }}"
      threads: "{{ env_var('DBT_THREADS', '4') | int }}"

      # Auth strategy selector (no Jinja blocks allowed in profiles.yml)
      # externalbrowser | oauth | snowflake_jwt
      authenticator: "{{ env_var('SNOWFLAKE_AUTHENTICATOR', 'externalbrowser') }}"

      # Password auth (kept for compatibility; prefer externalbrowser/oauth/jwt)
      password: "{{ env_var('SNOWFLAKE_PASSWORD', '') }}"

      # OAuth
      oauth_client_id: "{{ env_var('SNOWFLAKE_OAUTH_CLIENT_ID', '') }}"
      oauth_client_secret: "{{ env_var('SNOWFLAKE_OAUTH_CLIENT_SECRET', '') }}"
      oauth_access_token: "{{ env_var('SNOWFLAKE_OAUTH_ACCESS_TOKEN', '') }}"

      # Key-pair (JWT)
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH', '') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"

      # Network
      client_session_keep_alive: "{{ env_var('SNOWFLAKE_KEEP_ALIVE', 'false') | as_bool }}"
