# Required
BQ_PROJECT=
BQ_DATASET=
BQ_LOCATION=EU

# Auth
# oauth | service-account | service-account-json
BQ_METHOD=oauth

# service-account (path to JSON key)
BQ_KEYFILE=

# service-account-json (raw JSON)
BQ_KEYFILE_JSON=

# Optional tuning
BQ_PRIORITY=interactive
BQ_RETRIES=1
BQ_MAX_BYTES_BILLED=

# General
DBT_THREADS=4
DBT_TARGET=dev
