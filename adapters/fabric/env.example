# Required
FABRIC_SERVER=
FABRIC_DATABASE=
FABRIC_SCHEMA=

# Auth method
# service_principal | azure_cli | interactive | sql_password
FABRIC_AUTH_METHOD=service_principal

# Service principal (recommended)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SQL username/password (optional / legacy)
FABRIC_USER=
FABRIC_PASSWORD=

# ODBC / TLS
FABRIC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_ENCRYPT=yes
FABRIC_TRUST_SERVER_CERTIFICATE=no

# General
DBT_THREADS=4
DBT_TARGET=dev
