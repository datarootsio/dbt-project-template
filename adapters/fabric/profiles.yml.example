dbt_project_template:
  target: "{{ env_var('DBT_TARGET', 'dev') }}"
  outputs:
    dev:
      # dbt-fabric adapter
      type: fabric
      server: "{{ env_var('FABRIC_SERVER') }}"
      database: "{{ env_var('FABRIC_DATABASE') }}"
      schema: "{{ env_var('FABRIC_SCHEMA') }}"
      threads: "{{ env_var('DBT_THREADS', '4') | int }}"

      # Auth method selector (no Jinja blocks allowed in profiles.yml)
      # service_principal | azure_cli | interactive | sql_password
      authentication: "{{ env_var('FABRIC_AUTH_METHOD', 'service_principal') }}"

      # Service principal (recommended for CI)
      tenant_id: "{{ env_var('AZURE_TENANT_ID', '') }}"
      client_id: "{{ env_var('AZURE_CLIENT_ID', '') }}"
      client_secret: "{{ env_var('AZURE_CLIENT_SECRET', '') }}"

      # SQL username/password (legacy / only if required)
      user: "{{ env_var('FABRIC_USER', '') }}"
      password: "{{ env_var('FABRIC_PASSWORD', '') }}"

      # ODBC / TLS
      driver: "{{ env_var('FABRIC_DRIVER', 'ODBC Driver 18 for SQL Server') }}"
      encrypt: "{{ env_var('FABRIC_ENCRYPT', 'yes') }}"
      trust_server_certificate: "{{ env_var('FABRIC_TRUST_SERVER_CERTIFICATE', 'no') }}"
