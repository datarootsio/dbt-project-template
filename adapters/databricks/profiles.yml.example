dbt_project_template:
  target: "{{ env_var('DBT_TARGET', 'dev') }}"
  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"

      catalog: "{{ env_var('DATABRICKS_CATALOG', 'hive_metastore') }}"

      schema: "{{ env_var('DATABRICKS_SCHEMA') }}"

      threads: "{{ env_var('DBT_THREADS', '4') | int }}"

      auth_type: "{{ env_var('DATABRICKS_AUTH_TYPE', 'oauth') }}"

      token: "{{ env_var('DATABRICKS_TOKEN', '') }}"

      client_id: "{{ env_var('DATABRICKS_CLIENT_ID', '') }}"
      client_secret: "{{ env_var('DATABRICKS_CLIENT_SECRET', '') }}"
      tenant_id: "{{ env_var('DATABRICKS_TENANT_ID', '') }}"