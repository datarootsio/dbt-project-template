# Required
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_SCHEMA=

# Optional
DATABRICKS_CATALOG=

# Auth type (recommended: oauth)
# token | oauth
DATABRICKS_AUTH_TYPE=oauth

# Token auth (PAT)
DATABRICKS_TOKEN=

# OAuth (Azure SP / AAD app)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TENANT_ID=

# General
DBT_THREADS=4
DBT_TARGET=dev
