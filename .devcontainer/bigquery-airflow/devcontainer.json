{
  "name": "dbt-template (bigquery + airflow)",
  "image": "ghcr.io/datarootsio/dbt-runtime-bigquery:1.8.0",
  "remoteUser": "dbtuser",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "ADAPTER": "bigquery",
    "DBT_TARGET": "dev",
    "DBT_PROFILES_DIR": "/profiles",
    "RUN_DBT_DEPS": "1",
    "RUN_DBT_PARSE": "0",
    "DBT_PROFILE": "dbt_project_template",
    "DBT_PROJECT_DIR": "/workspaces/${localWorkspaceFolderBasename}",
    "ORCHESTRATOR": "airflow"
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "innoverio.vscode-dbt-power-user",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  },
  "forwardPorts": [
    8080
  ]
}
